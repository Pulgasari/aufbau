// @aufbau/svg/filters/data.json5
// single source of truth for filter metadata, options and preview ranges.
// each key in `vars` maps 1:1 to a --aufbau-filter-<key> custom property.
// every `default` MUST match the fallback written into the matching .svg.

[
  {
    id   : 'blur',
    name : 'Blur',
    vars : {
      amount : { type: 'number', default: 2, min: 0, max: 20, step: 0.5, unit: 'px' },
    },
  },
  {
    id   : 'grain',
    name : 'Grain',
    vars : {
      frequency : { type: 'number' , default: 0.8 , min: 0, max: 2, step: 0.05 },
      octaves   : { type: 'integer', default: 2   , min: 1, max: 5, step: 1    },
      opacity   : { type: 'number' , default: 0.15, min: 0, max: 1, step: 0.01 },
    },
  },
]
