# ======================================================================
# ASS :: LANGUAGE SPECIFICATION DATA :: ass.lsd
# ======================================================================

# //////////// META ////////////////////////////////////////////////////

META LIST :: keywords == @scope @theme @layer @keyframes @media @aufbau @trait @tokens @config
META LIST :: puncts   == { } : ; , ( ) . # & > + ~ * [ ] =

# //////////// TOKENIZER ///////////////////////////////////////////////

TKN :: COMMENT     == /\/\*[\s\S]*?\*\/|\/\/.*/y
TKN :: WHITESPACE  == /[ \t\n\r]+/y

TKN :: AT_KEYWORD  == /@[a-zA-Z0-9_-]+/y
TKN :: VARIABLE    == /\$[a-zA-Z0-9_-]+/y
TKN :: CUSTOM_PROP == /--[a-zA-Z0-9_-]+/y
TKN :: OPERATOR    == /\+|\-|\*|\//y
TKN :: PUNCT       == @puncts
TKN :: NUMBER      == /-?\d+(?:\.\d+)?(?:[a-zA-Z%]+)?/y
TKN :: STRING      == /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/y
TKN :: IDENTIFIER  == /[a-zA-Z_][a-zA-Z0-9_-]*/y

# //////////// RULES ///////////////////////////////////////////////////

RULE :: Sheet      == Statement*
RULE :: Statement  == VarDecl | AtRule | Rule | Declaration
RULE :: Block      == `{` Statement* `}` => 2

# ------------ Declarations & Variables --------------------------------

#### VarDecl
META :: VarDecl
NODE == { name, value }
RULE == VARIABLE `:` Value `;` => name:1 value:3

#### MapDeclaration
META :: MapDeclaration
NODE == { name, entries }
RULE == IDENTIFIER `:` `{` Declaration* `}` `;` => name:1 entries:4

#### Declaration
META :: Declaration
NODE == { name, value }
RULE == ( IDENTIFIER | CUSTOM_PROP ) `:` Value `;` => name:1 value:3

RULE :: Value      == ValueItem+
RULE :: ValueItem  == BinaryExpr | FuncCall | VARIABLE | CUSTOM_PROP | IDENTIFIER | NUMBER | STRING | OPERATOR | PUNCT

#### BinaryExpr
META :: BinaryExpr
NODE == { left, operator, right }
RULE == Primary OPERATOR Primary => left:1 operator:2 right:3

RULE :: Primary    == FuncCall | VARIABLE | CUSTOM_PROP | IDENTIFIER | NUMBER | STRING

#### FuncCall
META :: FuncCall
NODE == { name, args }
RULE == IDENTIFIER `(` ValueItem* `)` => name:1 args:3

# ------------ Rules & Selectors ---------------------------------------

#### Rule
META :: Rule
NODE == { selector, body }
RULE == Selector Block => selector:1 body:2

RULE :: Selector     == SelectorPart+
RULE :: SelectorPart == IDENTIFIER | NUMBER | STRING | PUNCT

# ------------ AtRules -------------------------------------------------

#### AtRule
META :: AtRule
NODE == { name, params, body }
RULE == AT_KEYWORD AtParams? Block => name:1 params:2 body:3
RULE == AT_KEYWORD AtParams? `;`   => name:1 params:2

RULE :: AtParams    == AtParamItem+
RULE :: AtParamItem == IDENTIFIER | NUMBER | STRING | PUNCT
