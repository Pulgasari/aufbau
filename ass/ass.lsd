# ======================================================================
# ASS :: LANGUAGE SPECIFICATION DATA :: ass.lsd
# ======================================================================

# //////////// META ////////////////////////////////////////////////////

META LIST :: keywords == @scope @theme @layer @keyframes @media @aufbau
META LIST :: puncts   == { } : ; , ( ) . # & > + ~ * [ ] =

# //////////// TOKENIZER ///////////////////////////////////////////////

TKN :: COMMENT     == /\/\*[\s\S]*?\*\/|\/\/.*/y
TKN :: WHITESPACE  == /[ \t\n\r]+/y

TKN :: AT_KEYWORD  == /@[a-zA-Z0-9_-]+/y
TKN :: PUNCT       == @puncts
TKN :: NUMBER      == /-?\d+(?:\.\d+)?(?:[a-zA-Z%]+)?/y
TKN :: STRING      == /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/y
TKN :: IDENTIFIER  == /[a-zA-Z_][a-zA-Z0-9_-]*/y

# //////////// RULES ///////////////////////////////////////////////////

RULE :: Sheet      == Statement*
RULE :: Statement  == AtRule | Rule | Declaration
RULE :: Block      == `{` Statement* `}` => 2

# ------------ Declarations --------------------------------------------

#### Declaration
META :: Declaration
NODE == { name, value }
RULE == IDENTIFIER `:` Value `;` => name:1 value:3

RULE :: Value      == ValueItem+
RULE :: ValueItem  == IDENTIFIER | NUMBER | STRING | PUNCT

# ------------ Rules & Selectors ---------------------------------------

#### Rule
META :: Rule
NODE == { selector, body }
RULE == Selector Block => selector:1 body:2

RULE :: Selector     == SelectorPart+
RULE :: SelectorPart == IDENTIFIER | NUMBER | STRING | PUNCT

# ------------ AtRules -------------------------------------------------

#### AtRule
META :: AtRule
NODE == { name, params, body }
RULE == AT_KEYWORD AtParams? Block => name:1 params:2 body:3
RULE == AT_KEYWORD AtParams? `;`   => name:1 params:2

RULE :: AtParams    == AtParamItem+
RULE :: AtParamItem == IDENTIFIER | NUMBER | STRING
