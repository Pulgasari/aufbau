{
  "name": "@aufbau/elements",
  "version": "2.0.0",
  "description": "Custom elements for the @aufbau ecosystem: the aufbau-* building blocks and the app, div, embed, input and write elements composed of them",
  "type"   : "module",
  "main"   : "./index.js",
  "module" : "./index.js",
  "sideEffects": [
    "./webcomponents/*.js",
    "./webcomponents/input/tags.js"
  ],
  "exports": {
    "."     : "./index.js",
    "./htx" : "./adapters/htx.js",
    "./*"   : "./*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "adapters",
    "data",
    "lib",
    "webcomponents",
    "README.md"
  ],
  "dependencies": {
    "@aufbau/element": "^0.1.0"
  },
  "peerDependencies": {
    "@aufbau/gui": "^0.1.0",
    "@aufbau/import": "^1.0.0"
  },
  "keywords": [
    "aufbau",
    "custom-elements",
    "esm",
    "ui-kit",
    "web-components"
  ],
  "license": "MIT",
  "aufbau": {
    "bundle": {
      "keep": ["./"]
    }
  }
}
