{
  "name": "@aufbau/components",
  "version": "0.1.0",
  "description": "Ready to use components composed of @aufbau/elements",
  "type"   : "module",
  "main"   : "./index.js",
  "module" : "./index.js",
  "sideEffects": [
    "./app/*.js",
    "./div/*.js",
    "./embed/*.js",
    "./input/*.js",
    "./write/*.js"
  ],
  "exports": {
    "."     : "./index.js",
    "./htx" : "./adapters/htx.js",
    "./*"   : "./*"
  },
  "files": [
    "index.js",
    "adapters/*.js",
    "app/*.js",
    "core/*.js",
    "data/*.js",
    "div/*.js",
    "embed/*.js",
    "input/*.js",
    "write/*.js",
    "README.md"
  ],
  "peerDependencies": {
    "@aufbau/elements": "^1.0.0",
    "@aufbau/gui": "^0.1.0"
  },
  "keywords": [
    "aufbau",
    "custom-elements",
    "web-components"
  ],
  "license": "MIT",
  "aufbau": {
    "bundle": {
      "keep": ["./"]
    }
  }
}
