{
  "name": "@aufbau/import",
  "version": "1.0.0",
  "description": "Dynamic multi-format asset loader for the browser (CSV, ENV, GLSL, INI, JSON5, JSONL, JSX, Less, MD, Sass, TOML, TS, WASM, XML, YAML).",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "@bunker/db"    : "^0.1.0",
    "@bunker/policy": "^0.1.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "readme.md",
    "LICENSE"
  ],
  "keywords": [
    "aufbau",
    "browser",
    "esm",
    "loader",
    "dynamic-import"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulgasari/aufbau.git",
    "directory": "packages/import"
  }
}
