{
  "name": "@aufbau/gestures",
  "version": "2.1.0",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./debug": {
      "types": "./debug.d.ts",
      "default": "./debug.js"
    },
    "./events": {
      "types": "./adapters/events.d.ts",
      "default": "./adapters/events.js"
    },
    "./preact": {
      "types": "./adapters/preact.d.ts",
      "default": "./adapters/preact.js"
    },
    "./simulate": {
      "types": "./simulate.d.ts",
      "default": "./simulate.js"
    },
    "./*": "./*"
  },
  "peerDependencies": {
    "preact": "*"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "license": "MIT"
}
