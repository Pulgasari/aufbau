{
  "name": "@aufbau/elements2",
  "version": "0.1.0",
  "description": "Custom elements for the @aufbau ecosystem: the aufbau-* building blocks and the app, div, embed, input and write elements composed of them",
  "type"   : "module",
  "main"   : "./index.js",
  "module" : "./index.js",
  "sideEffects": [
    "./app/*.js",
    "./aufbau/*.js",
    "./div/*.js",
    "./embed/*.js",
    "./input/*.js",
    "./write/*.js"
  ],
  "exports": {
    "."     : "./index.js",
    "./htx" : "./adapters/htx.js",
    "./*"   : "./*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "adapters/*.js",
    "app/*.js",
    "aufbau/*.js",
    "base/*.js",
    "lib/*.js",
    "data/*.js",
    "div/*.js",
    "embed/*.js",
    "input/*.js",
    "looks/*.js",
    "write/*.js",
    "CONTROLS.md",
    "CSS-CONFIG.md",
    "README.md"
  ],
  "peerDependencies": {
    "@aufbau/gui": "^0.1.0",
    "@aufbau/import": "^1.0.0"
  },
  "keywords": [
    "aufbau",
    "custom-elements",
    "esm",
    "ui-kit",
    "web-components"
  ],
  "license": "MIT",
  "aufbau": {
    "bundle": {
      "keep": ["./"]
    }
  }
}
